# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=path_pilot

# Firebase Admin Configuration (JSON path or environment credentials)
FIREBASE_PROJECT_ID=path-pilot-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@path-pilot-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: Path to Firebase Service Account JSON file
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Development mode flag
DEV_MODE=true
